{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"paths": { "@/lib/types": ["../frontend/src/lib/types/map.ts"] },
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"],
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src"]
}
