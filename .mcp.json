{
  "mcpServers": {
    "ragged-crown": {
      "command": "node",
      "args": ["mcp/node_modules/tsx/dist/cli.mjs", "mcp/src/index.ts"],
      "env": { "RC_API_URL": "http://localhost:8080" }
    },
    "ragged-crown-sandbox": {
      "command": "node",
      "args": ["mcp/node_modules/tsx/dist/cli.mjs", "mcp/src/index.ts"],
      "env": { "RC_API_URL": "http://localhost:8081" }
    }
  }
}
